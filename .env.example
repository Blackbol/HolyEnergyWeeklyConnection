# ==============================================================================
# Holy Energy — Connexion Hebdomadaire
# ==============================================================================

# [OBLIGATOIRE] Cookie de session _shopify_essential extrait de votre navigateur
# Sur https://fr.holy.com -> F12 -> Application -> Cookies -> _shopify_essential
HOLY_SHOPIFY_COOKIE=:AZ...collez_votre_cookie_complet_ici...

# [OPTIONNEL] Adresse email du compte (utilisée pour les logs et notifications)
HOLY_EMAIL=votre.email@exemple.com

# ==============================================================================
# Planification (Mode Démon Docker ou Local)
# ==============================================================================
# Jour de passage : monday, tuesday, wednesday, thursday, friday, saturday, sunday
HOLY_SCHEDULE_DAY=monday

# Heure de passage (format HH:MM)
HOLY_SCHEDULE_TIME=08:00

# Exécuter immédiatement au démarrage du conteneur en plus du cron hebdomadaire
HOLY_RUN_ON_STARTUP=true

# Fuseau horaire
TZ=Europe/Paris

# Timeout réseau (secondes)
HOLY_TIMEOUT=30

# Niveau de verbosité des logs : PROD (recommandé), INFO, DEBUG
LOG_LEVEL=PROD

# ==============================================================================
# Notifications (Optionnel)
# ==============================================================================
# Discord Webhook URL :
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Telegram Bot :
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI...
# TELEGRAM_CHAT_ID=123456789

# ntfy.sh (Push sur application mobile Android/iOS, gratuit sans inscription) :
# NTFY_TOPIC=mon-topic-holy-perso
# NTFY_SERVER=https://ntfy.sh
